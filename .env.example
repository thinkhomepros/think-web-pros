# Port the server listens on
PORT=3000
# Enables the live AI logo maker (leave blank to use the built-in quick ideas)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
# Secret for reading orders at GET /api/orders (Authorization: Bearer <token>)
ADMIN_TOKEN=
# Where orders are stored when Redis isn't set up
DATA_DIR=data
# Durable order storage (Upstash Redis). Vercel's Upstash integration fills in KV_REST_API_URL / KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Your site's address, used for the links Stripe sends people back to (default: the address the request came in on)
PUBLIC_URL=

# Cards, Apple Pay, Google Pay, Cash App Pay, Link, bank and Klarna/Afterpay (Stripe). Use sk_test_ keys until you're ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal and Venmo. PAYPAL_ENV is sandbox (testing) or live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Zelle: the email or US phone number enrolled with Zelle, and the name customers will see
ZELLE_RECIPIENT=
ZELLE_NAME=Think Web Pros

# --- Security (all optional; each turns on when set) ---
# Cloudflare Turnstile bot check on orders and the AI logo maker (free: dash.cloudflare.com > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# AI logo maker limits: requests per visitor per day, and for all visitors together per day
AI_PER_DAY=100
AI_DAILY_TOTAL=1000
# Rate limit counts are shared across servers through the same Upstash Redis as orders (KV_REST_API_* or UPSTASH_REDIS_REST_* above)
# Card payments for shops (Stripe Connect): each shop is paid on its own Stripe account. See docs/payments-setup.md section 6.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional cut of each shop sale for Think Web Pros, in percent (0 to 10). Empty = none.
SHOP_FEE_PERCENT=
# Receipts and order alerts (docs/payments-setup.md section 7). Each is off until set.
RESEND_API_KEY=
EMAIL_FROM=

# --- Register (/pos) and kitchen screen (/kitchen); see docs/pos-setup.md ---
# Card readers use STRIPE_SECRET_KEY above (sk_test_ gives Stripe's simulated reader, no hardware needed).
# Email and text receipts use RESEND_API_KEY / EMAIL_FROM above and TWILIO_* below.
# What Think Web Pros keeps from each register card payment on a shop's own Stripe account, e.g. 0.5 and 5 = 0.5% + 5c
POS_FEE_PERCENT=0
POS_FEE_CENTS=0
# Text receipts and order alerts (twilio.com): account SID, auth token, and the Twilio number they come from (+15551234567)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
