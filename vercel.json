{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": true,
  "redirects": [
    { "source": "/guide", "destination": "/builder", "permanent": true },
    { "source": "/guide.html", "destination": "/builder", "permanent": true }
  ],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": { "api/index.js": { "maxDuration": 60 } }
}
